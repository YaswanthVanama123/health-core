@model IEnumerable<GeniView.Data.Web.Community>

<div>@Html.ValidationMessage("DbFail", new { @class = "text-danger" })</div>

<div class="panel panel-default">
    <div class="panel-heading">
        <div class="row">
            <div class="col-sm-6">
                <h4>Communities</h4>
            </div>
            <div class="col-sm-6 text-right">
                @Html.ActionLink("Add New Community", "Create", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
    <div class="panel-body">
        <table id="CommunitiesTable" class="table table-hover table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Create Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    var i = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@item.Name</td>
                            <td>@(item.Description ?? "--")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="label label-success">Active</span>
                                }
                                else
                                {
                                    <span class="label label-danger">Inactive</span>
                                }
                            </td>
                            <td>@item.CreateDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-sm btn-default" })
                            </td>
                        </tr>
                        i++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>
